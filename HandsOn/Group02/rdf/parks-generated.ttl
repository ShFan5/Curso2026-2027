<https://parques-jardines.madrid.data.es/resource/park/10966448>
    a parks:Park;
    parks:parkName "Plaza Mayor de Barajas"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "La Plaza Mayor de Barajas anteriormente era denominada como Plaza de los Hermanos Falc y lvarez de Toledo. 'Llamada por los vecinos Plaza Mayor de Barajas, encarna el canon de las plazas pblicas renacentistas espaolas mandadas construir bajo el reinado de Felipe II. Est constituida por un espacio cuadrangular limitado por cuatro galeras realizadas a base de columnas dricas de granito que soportan las tpicas zapatas de madera de nuestra arquitectura popular. Sobre ellas se encuentran antiguas casas de una altura, que logran una uniformidad poco habitual. En su centro se dispuso un jardn regular en forma radial compuesto por setos de aligustre, acacias y algunos cedros que rodean una fuente con una escultura de bronce. Completa este ajardinamiento una hilera de acacias alrededor, en las aceras, as como zonas de csped con prunos y flores'. (Extracto del libro Jardines de Madrid de Carmen Ariza)"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Metro: Lnea 8 (Barajas) Bus: 101 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=ee9654348a62b610VgnVCM2000001f4a900aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.4735113714068"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.57805132010274"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/10966448>;
    parks:locatedInDistrict <https://parques-jardines.madrid.data.es/resource/district/21>;
    parks:locatedInNeighborhood <https://parques-jardines.madrid.data.es/resource/neighborhood/3> .
