    a parks:Park;
    parks:parkName "Jardines Gregorio Ordez"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Los jardines en memoria de Gregorio Ordez cuentan con dos amplias reas de juegos infantiles, diseadas para el disfrute de la infancia. En su centro, se encuentra un encantador estanque rodeado de diversas especies de palmeras, que aportan un toque extico y natural al entorno."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles"^^<http://www.w3.org/2001/XMLSchema#string>;
