<https://parques-jardines.madrid.data.es/resource/park/5984737>
    a parks:Park;
    parks:parkName "Parque Ladera de los Almendros"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "El Parque Ladera de los Almendros es un parque periurbano que sirve de transicin entre las viviendas del barrio de Valdebernardo y la autopista M-40. Se caracteriza por un diseo que integra un paseo arbolado paralelo a la M-40. Adems, cuenta con una amplia zona estancial abierta y arbolada y en su superficie predominan las catalpas, almeces, acacias del Japn y pinos pioneros. El parque dispone de varias instalaciones para el disfrute de todos los pblicos: un rea de juegos infantiles, una zona de ejercicios para mayores y una zona canina."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles Zonas caninas"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Bus: 8 , 71 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=60d548147809e210VgnVCM2000000c205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.39616431537003"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.6261065047300303"^^<http://www.w3.org/2001/XMLSchema#decimal>;
