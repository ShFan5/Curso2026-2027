    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=ee1a6a14ec67e210VgnVCM2000000c205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
