<https://parques-jardines.madrid.data.es/resource/park/5993103>
    a parks:Park;
    parks:parkName "Parque de Francos Rodrguez"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "El Parque de Francos Rodrguez es un espacio modesto y antiguo en el distrito, muy concurrido y apreciado por el vecindario. Un elemento distintivo es una pequea ra que divide la zona verde del parque en dos secciones. Esta ra era parte del Canalillo, una infrastructura hidrulica que atravesaba todo Madrid con el objetivo de evacuar los caudales de agua excedentes del Canal de Isabel II. El parque cuenta con una amplia pradera y una excelente cobertura arbrea, lo que proporciona zonas de sombra y frescor. Adems, dispone de reas infantiles ubicadas en el paseo de las Moreras y aparcamientos para bicicletas. Su diseo, que asla del entorno urbano, lo convierte en un lugar ideal para desconectar y disfrutar de la naturaleza en plena ciudad."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles Aparcamientos de bicicletas"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Bus: 132, 44 Metro: Francos Rodrguez (lnea 7) Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=4bafb863b84be210VgnVCM1000000b205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.45374298443811"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.714179732136829"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5993103>;
