    a parks:Park;
    parks:parkName "Jardn Glorieta de Azorn"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Pequeo jardincillo situado en la denominada Cuesta de la Vega, bajo la Catedral de la Almudena. Le debe su nombre al escritor Jos Martnez Ruiz 'Azorn'."^^<http://www.w3.org/2001/XMLSchema#string>;
