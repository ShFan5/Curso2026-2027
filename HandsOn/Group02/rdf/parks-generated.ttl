<https://parques-jardines.madrid.data.es/resource/park/5978923>
    a parks:Park;
    parks:parkName "Jardn del Bulevar de Pea Gorbea"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "El Jardn del Bulevar de Pea Gorbea es un amplio paseo ajardinado que se extiende entre dos calles, ofreciendo un entorno agradable y fresco gracias a su densa cobertura arbrea. A lo largo del bulevar, se encuentran bancos estratgicamente ubicados, brindando espacios ideales para el descanso y la socializacin. Este lugar es frecuentemente concurrido y sirve como punto de encuentro para eventos vecinales, mercadillos semifijos y diferentes actividades comerciales. Cada verano se celebra aqu la conocida Batalla Naval de Vallecas. En uno de los extremos del paseo destaca una moderna escultura titulada Los Paseantes, que aade un toque artstico al entorno. Tambin conocido como Paseo Antoln Pulido o Bulevar del Puente de Vallecas, este espacio combina naturaleza, cultura y vida urbana, siendo un referente para la comunidad local."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Metro: Puente Vallecas (lnea 1) Bus: 10, 24, 54, 57, 58, 310 y 410 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=1aaf38317117e210VgnVCM1000000b205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.3957812018463"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.6670346724676173"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5978923>;
    parks:locatedInDistrict <https://parques-jardines.madrid.data.es/resource/district/13>;
    parks:locatedInNeighborhood <https://parques-jardines.madrid.data.es/resource/neighborhood/2> .
