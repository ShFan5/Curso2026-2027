    a parks:Park;
    parks:parkName "Parque Nudo Norte de Begoa"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Parque muy visible desde la M-30 con un gran talud de pradera. Tiene zonas infantiles a la salida del metro, lugares estanciales muy cmodos y campos de ftbol sala y baloncesto."^^<http://www.w3.org/2001/XMLSchema#string>;
