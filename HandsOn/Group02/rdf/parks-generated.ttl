<https://parques-jardines.madrid.data.es/resource/park/5964328>
    a parks:Park;
    parks:parkName "Jardn del Maestro Padilla"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Este parque urbano ajardinado est distribuido en dos alturas y cuenta con un paseo central pavimentado, as como reas de esparcimiento equipadas con bancos y mesas de juego. La vegetacin es variada; presenta dos espacios diferenciados de csped, mientras que el resto del parque est adornado con arbolado, destacando el pino pionero y el tilo. Adems, incluye una zona delimitada para juegos infantiles, lo que lo convierte en un lugar ideal para disfrutar en familia."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Bus: 25, 33, 39, 41, 68, 69, 138 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=40538ced5a23e210VgnVCM1000000b205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.404491323444994"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.7213308239798675"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5964328>;
    parks:locatedInDistrict <https://parques-jardines.madrid.data.es/resource/district/2>;
