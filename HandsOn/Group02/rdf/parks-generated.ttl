<https://parques-jardines.madrid.data.es/resource/park/5994445>
    a parks:Park;
    parks:parkName "Jardn Jazmn"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "El parque, discretamente ubicado sobre la cubierta de las cocheras del metro, se caracteriza por una extensin completamente compuesta de pradera natural, complementada por plantaciones arbreas y herbceas en su mayora. Aunque las instalaciones son humildes, con apenas algunos bancos y una modesta iluminacin, el espacio es frecuentemente visitado por personas que disfrutan pasear con sus mascotas. Considerando las limitaciones del suelo disponible, dispone de especies vegetales adaptadas a un escaso espesor de suelo y con alta resistencia a la sequa, organizadas en un esquema de bandas, con el sistema de riego automtico por goteo."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles Instalaciones deportivas"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Bus: 29, 125, 129, 150 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=cae5e8d9af8be210VgnVCM1000000b205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.481785094079584"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.660098332215654"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5994445>;
