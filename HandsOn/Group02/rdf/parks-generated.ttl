    parks:latitude "40.41214880704316"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.7356620312409365"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5982306>;
