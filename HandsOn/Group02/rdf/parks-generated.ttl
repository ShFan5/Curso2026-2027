<https://parques-jardines.madrid.data.es/resource/park/6011067>
    a parks:Park;
    parks:parkName "Jardn de Larra"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Desde este jardn se puede admirar el atardecer de Madrid con vistas a la Catedral de la Almudena y al Palacio Real. Se trata de un pequeo espacio verde ajardinado, que cuenta con una cubierta de csped en forma de talud, la cual separa las diferentes alturas de las calles que lo delimitan, Bailn y Factor. Un pequeo camino de terrizo atraviesa el jardn, que suele estar concurrido en los das de buen tiempo."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Metro: Opera (lneas 2, 5 y ramal) Bus: 3, 148 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=04de61226f6ee210VgnVCM1000000b205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.41631909566782"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.712793771176405"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/6011067>;
    parks:locatedInDistrict <https://parques-jardines.madrid.data.es/resource/district/1>;
