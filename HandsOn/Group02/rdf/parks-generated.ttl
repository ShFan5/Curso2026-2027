<https://parques-jardines.madrid.data.es/resource/park/11040880>
    a parks:Park;
    parks:parkName "Parque Juan de la Cosa"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Parque modesto ubicado entre las calles Potos, Cochabamba y Vctor Andrs Belaunde. Es un espacio verde dedicado a Juan de la Cosa, navegante y cartgrafo espaol, que particip junto a Cristbal Coln en el descubrimiento de Amrica, y autor del primer mapa en el que aparece el continente americano. Dispone de una espacios ajardinados con un paseo de terrizo, un rea de cesped, una zona de juegos infantiles y alberga un pequeo bar/cafetera con terraza en su interior."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zonas infantiles"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Metro: lneas 8 y 9 (Colombia) Bus: 14, 7, 16, 29, 51"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
