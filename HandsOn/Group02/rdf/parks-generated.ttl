<https://parques-jardines.madrid.data.es/resource/park/5996843>
    a parks:Park;
    parks:parkName "Jardn de la Colonia Congosto"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "Este espacio ajardinado destaca por una extensa zona estancial situada alrededor de la cafetera existente. El parque cuenta con numerosos macizos arbustivos de adelfa, cotoneaster y celinda, as como rboles maduros entre los que destacan el olmo de siberia, el pino carrasco, el almez y el ciprs comn. Adems, dispone de un rea de juegos infantiles en su zona este, as como de un rea canina. El parque es tambin conocido por otras denominaciones, tales como Parque Congosto o Parque Camino Congosto."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zona infantil Zona canina"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:publicTransport "Metro: Congosto (lnea 1) Bus: 54 y L1 Servicio Bicimad, para consultar la estacin ms cercana, acceda al mapa de geolocalizacin de las estaciones."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:accessibility "2"^^<http://www.w3.org/2001/XMLSchema#integer>;
    parks:contentUrl "http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=f8a5d9e4faebe210VgnVCM2000000c205a0aRCRD"^^<http://www.w3.org/2001/XMLSchema#anyURI>;
    parks:latitude "40.37089825532696"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:longitude "-3.618365854832584"^^<http://www.w3.org/2001/XMLSchema#decimal>;
    parks:hasAddress <https://parques-jardines.madrid.data.es/resource/address/5996843>;
    parks:locatedInDistrict <https://parques-jardines.madrid.data.es/resource/district/18>;
