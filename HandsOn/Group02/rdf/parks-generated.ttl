    a parks:Park;
    parks:parkName "Parque San Jos de Calasanz"^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:description "El Parque San Jos de Calasanz es un modesto parque urbano, principalmente pavimentado, que cuenta con zonas ajardinadas que incluyen masas arbustivas y rboles de sombra. El parque dispone de una zona infantil diseada con el mismo tipo de plantacin, lo que permite aislarla del trfico vehicular de las calles adyacentes. Este espacio tambin es conocido como Jardines de Joaqun Mara Lpez."^^<http://www.w3.org/2001/XMLSchema#string>;
    parks:facilities "Zona Infantil"^^<http://www.w3.org/2001/XMLSchema#string>;
